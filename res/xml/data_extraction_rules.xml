<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8: cloud/device transfer rules (API 31+). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="saves/" />
        <include domain="file" path="screenshots/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="saves/" />
        <include domain="file" path="screenshots/" />
    </device-transfer>
</data-extraction-rules>
